# Copy this file to .env before running Docker Compose.
# Use long, random values outside local development.
QUERYECHO_DB_PASSWORD=change-this-database-password
QUERYECHO_INGEST_API_KEY=change-this-ingest-api-key

QUERYECHO_PORT=8080
QUERYECHO_POSTGRES_PORT=5433
QUERYECHO_IMAGE=ghcr.io/queryecho/queryecho-app
QUERYECHO_VERSION=latest

